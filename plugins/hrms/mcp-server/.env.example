# The HRMS plugin's MCP server. Dev-only placeholders — never a real value here.

# The HRMS's own MCP endpoint, and the API key it expects in X-API-Key.
HRMS_MCP_URL=http://hrms:8080/api/v1/mcp
HRMS_API_KEY=replace-me

# Where the HRMS finds a person by work email, and the bearer it expects there.
HRMS_LOOKUP_URL=http://hrms:8080/api/v1/agentic/users/by-identifier
HRMS_LOOKUP_TOKEN=replace-me

# The bearer Enterprise Claw sends this server — both as the MCP server's
# credential and as its lookup token. A long random string.
EC_TOKEN=replace-me-with-a-long-random-string

# Jira is not set up here. The HRMS reads it for the leave warnings, through the
# Jira connections an admin adds on its dashboard (Jira settings), with each
# project linked to its Jira project there. These only tune the warnings:
# a sprint is tight when it ends within this many working days after the leave,
# with more than this share of its tickets still open.
SPRINT_TIGHT_DAYS=3
SPRINT_TIGHT_OPEN_SHARE=0.3

# Optional — the titles of the company's two MBO guides, if the documents are not
# named "MBO acceptance criteria" and "Role expectations by designation". The MBO
# coach searches the Space's memory by these titles, so set the new one when a
# guide is renamed. Blank means the default title.
MBO_ACCEPTANCE_GUIDE=
MBO_ROLE_GUIDE=
